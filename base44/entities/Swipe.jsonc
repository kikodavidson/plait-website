{
  "name": "Swipe",
  "type": "object",
  "properties": {
    "file": {
      "type": "string",
      "description": "URL of the saved ad video file"
    },
    "thumbnail": {
      "type": "string",
      "description": "URL of the video thumbnail image"
    },
    "file_name": {
      "type": "string",
      "description": "Original uploaded file name, used for duplicate detection"
    },
    "file_size": {
      "type": "number",
      "description": "Original uploaded file size in bytes, used for duplicate detection"
    },
    "source_brand": {
      "type": "string",
      "description": "Brand the ad belongs to"
    },
    "source_url": {
      "type": "string",
      "description": "Original URL where the ad was found"
    },
    "platform": {
      "type": "string",
      "enum": [
        "Meta",
        "TikTok",
        "YouTube",
        "LinkedIn",
        "organic",
        "other"
      ]
    },
    "format": {
      "type": "string",
      "enum": [
        "UGC talking head",
        "UGC voiceover with b roll",
        "founder direct to camera",
        "customer testimonial",
        "creator review",
        "product demo",
        "screen recording or app demo",
        "street interview",
        "text over video",
        "green screen reaction",
        "split screen comparison",
        "unboxing",
        "podcast clip",
        "tutorial",
        "image carousel",
        "static image",
        "motion graphic",
        "day in the life",
        "mashup or compilation",
        "animated explainer",
        "meme",
        "ASMR",
        "AI generated",
        "cinematic brand film",
        "whiteboard"
      ]
    },
    "shot_type": {
      "type": "string",
      "enum": [
        "Selfie Handheld",
        "Tripod Static",
        "Screen Recording",
        "Voiceover With B Roll",
        "Mixed"
      ],
      "description": "How the ad is shot (required tag)"
    },
    "production_level": {
      "type": "string",
      "enum": [
        "Phone Raw",
        "Phone Polished",
        "Semi Pro",
        "Studio"
      ],
      "description": "Production level of the ad (required tag)"
    },
    "setting": {
      "type": "string",
      "enum": [
        "Car",
        "Bedroom",
        "Mirror Or Bathroom",
        "Kitchen",
        "Living Space",
        "Office Or Desk",
        "Studio",
        "Street Or Outdoors",
        "Event Or Venue",
        "Gym",
        "Screen Only",
        "Mixed"
      ],
      "description": "Where the ad takes place"
    },
    "hook_type": {
      "type": "string",
      "enum": [
        "problem callout",
        "bold claim",
        "question",
        "callout to audience",
        "stat or number",
        "negative warning",
        "curiosity gap",
        "before and after reveal",
        "social proof drop",
        "us versus them",
        "personal story open",
        "price reveal",
        "POV",
        "pattern interrupt visual",
        "list open",
        "mistake confession",
        "authority intro",
        "trend or audio hook",
        "competitor callout",
        "unboxing reveal"
      ]
    },
    "structure": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "problem solution",
          "listicle",
          "testimonial arc",
          "before and after",
          "demonstration",
          "story arc",
          "tutorial",
          "comparison",
          "objection handling",
          "myth bust",
          "transformation",
          "founder story",
          "data reveal",
          "FAQ",
          "reaction",
          "day in the life",
          "review roundup",
          "unboxing"
        ]
      },
      "description": "Multi-select: the narrative structure(s) used in the ad"
    },
    "talent": {
      "type": "string",
      "enum": [
        "creator",
        "customer",
        "founder",
        "none or product only",
        "employee",
        "actor",
        "influencer",
        "animated or AI"
      ]
    },
    "vertical": {
      "type": "string",
      "enum": [
        "ecom",
        "app",
        "B2B",
        "local service",
        "other"
      ]
    },
    "angle_type": {
      "type": "string",
      "enum": [
        "pain point",
        "benefit or value",
        "social proof",
        "offer or discount",
        "objection handling",
        "education",
        "differentiation",
        "authority",
        "urgency or scarcity",
        "cost of inaction",
        "ease and convenience",
        "speed of result",
        "identity and belonging",
        "aspiration",
        "risk reversal",
        "curiosity",
        "humor",
        "community"
      ]
    },
    "energy": {
      "type": "string",
      "enum": [
        "Calm Conversational",
        "Warm And Friendly",
        "Fast And Punchy",
        "High Energy",
        "Deadpan",
        "Sincere Or Emotional",
        "Urgent"
      ],
      "description": "The energy or vibe of the ad"
    },
    "edit_style": {
      "type": "string",
      "enum": [
        "Raw Single Take",
        "Jump Cuts",
        "Retention Edit",
        "Captions Only",
        "Kinetic Captions",
        "B Roll Layered",
        "Text Overlay Heavy",
        "Motion Graphics",
        "Split Screen",
        "Green Screen Reaction"
      ],
      "description": "Editing style used in the ad"
    },
    "why_it_works": {
      "type": "string",
      "description": "Internal analysis of why the ad works"
    },
    "date_saved": {
      "type": "string",
      "format": "date"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "file"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}