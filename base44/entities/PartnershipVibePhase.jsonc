{
  "name": "PartnershipVibePhase",
  "type": "object",
  "properties": {
    "phase": {
      "type": "string",
      "enum": [
        "foundation",
        "collect",
        "directions",
        "pick",
        "build",
        "lock"
      ],
      "description": "Which of the 6 vibe board phases this record tracks"
    },
    "order": {
      "type": "number",
      "description": "Phase order, 0 through 5"
    },
    "luke_done": {
      "type": "boolean",
      "default": false,
      "description": "Luke has signed off on this phase"
    },
    "max_done": {
      "type": "boolean",
      "default": false,
      "description": "Max has signed off on this phase"
    },
    "content": {
      "type": "string",
      "description": "Working notes for the phase (e.g. the Foundation feeling, in words)"
    },
    "workspace": {
      "type": "string",
      "default": "partnership",
      "description": "Workspace scope marker used by RLS"
    }
  },
  "required": [
    "phase"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.workspace": "{{user.data.client_slug}}"
        },
        {
          "data.workspace": {
            "$in": "{{user.data.workspaces}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.workspace": "{{user.data.client_slug}}"
        },
        {
          "data.workspace": {
            "$in": "{{user.data.workspaces}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.workspace": "{{user.data.client_slug}}"
        },
        {
          "data.workspace": {
            "$in": "{{user.data.workspaces}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.workspace": "{{user.data.client_slug}}"
        },
        {
          "data.workspace": {
            "$in": "{{user.data.workspaces}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}