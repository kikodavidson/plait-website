{
  "name": "BuildProject",
  "type": "object",
  "properties": {
    "client_name": {
      "type": "string",
      "description": "Client or store name"
    },
    "store_url": {
      "type": "string",
      "description": "myshopify or live domain"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "launched",
        "paused"
      ],
      "default": "active"
    },
    "target_launch": {
      "type": "string",
      "format": "date",
      "description": "Target launch date"
    },
    "completed_items": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "IDs of checked items from the checklist template"
    },
    "notes": {
      "type": "string",
      "description": "Free notes on this build"
    }
  },
  "required": [
    "client_name"
  ]
}