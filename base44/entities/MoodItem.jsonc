{
  "name": "MoodItem",
  "type": "object",
  "properties": {
    "level": {
      "type": "string",
      "enum": [
        "mood",
        "identity",
        "brands",
        "tech"
      ],
      "description": "Board section: Mood, Identity, Brands We Admire, or Tech"
    },
    "sub_section": {
      "type": "string",
      "description": "Sub section, e.g. Imagery, Fonts, Brands We Love, Anti Board (NOT US)"
    },
    "image_url": {
      "type": "string",
      "description": "Public URL of the image (uploaded file, pasted image, saved screenshot, or OG preview)"
    },
    "link_url": {
      "type": "string",
      "description": "Website link this reference was added from"
    },
    "domain": {
      "type": "string",
      "description": "Hostname of the linked site, shown on the card"
    },
    "fetch_status": {
      "type": "string",
      "enum": [
        "pending",
        "ready",
        "failed"
      ],
      "description": "Screenshot fetch status for link references"
    },
    "note": {
      "type": "string",
      "description": "Optional why note"
    },
    "hex_codes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Optional hex color codes shown as a swatch strip under the image"
    },
    "font_name": {
      "type": "string",
      "description": "Optional font name, rendered as a large sample under the image"
    },
    "source_link": {
      "type": "string",
      "description": "Optional source link for the reference"
    },
    "added_by": {
      "type": "string",
      "enum": [
        "Luke",
        "Max"
      ],
      "description": "Which partner added the reference"
    },
    "vote_luke": {
      "type": "string",
      "enum": [
        "love",
        "cut"
      ],
      "description": "Luke's vote: love or cut (unset = no vote yet)"
    },
    "vote_max": {
      "type": "string",
      "enum": [
        "love",
        "cut"
      ],
      "description": "Max's vote: love or cut (unset = no vote yet)"
    },
    "workspace": {
      "type": "string",
      "default": "partnership",
      "description": "Workspace scope marker used by RLS"
    }
  },
  "required": [
    "level",
    "sub_section",
    "added_by"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.workspace": "{{user.data.client_slug}}"
        },
        {
          "data.workspace": {
            "$in": "{{user.data.workspaces}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.workspace": "{{user.data.client_slug}}"
        },
        {
          "data.workspace": {
            "$in": "{{user.data.workspaces}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.workspace": "{{user.data.client_slug}}"
        },
        {
          "data.workspace": {
            "$in": "{{user.data.workspaces}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.workspace": "{{user.data.client_slug}}"
        },
        {
          "data.workspace": {
            "$in": "{{user.data.workspaces}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}