{
  "name": "ContactInquiry",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "service_interest": {
      "type": "string",
      "enum": [
        "clarity_audit",
        "launch_system",
        "growth_retainer",
        "other"
      ]
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "qualified",
        "closed"
      ],
      "default": "new"
    }
  },
  "required": [
    "name",
    "email"
  ]
}