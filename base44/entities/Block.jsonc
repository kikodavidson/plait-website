{
  "name": "Block",
  "type": "object",
  "properties": {
    "client_slug": {
      "type": "string",
      "description": "The slug of the Client this block belongs to"
    },
    "angle_id": {
      "type": "string",
      "description": "ID of the parent Angle"
    },
    "content_type": {
      "type": "string",
      "enum": [
        "HQ photo",
        "graphic carousel",
        "UGC",
        "HQ video edit",
        "static graphic",
        "motion graphic"
      ]
    },
    "video_format": {
      "type": "string",
      "enum": [
        "Talking head",
        "Voiceover over b roll",
        "Testimonial",
        "Product demo",
        "Review",
        "Before and after",
        "Tutorial",
        "Reaction",
        "Unboxing",
        "Screen recording or app walkthrough",
        "Kinetic text",
        "Skit or scripted comedy",
        "Street interview",
        "Split screen comparison",
        "Transformation",
        "Duet or stitch",
        "Podcast clip",
        "Trend audio",
        "Day in the life",
        "Slideshow",
        "Montage",
        "Mashup or compilation",
        "Animated explainer",
        "Documentary or brand film",
        "Behind the scenes",
        "ASMR or sensory",
        "Vlog",
        "Livestream clip",
        "Whiteboard",
        "AI generated"
      ],
      "description": "The narrative/structural format of a video creative"
    },
    "on_camera": {
      "type": "string",
      "enum": [
        "Creator",
        "Customer",
        "Founder",
        "Product only",
        "Actor",
        "Employee",
        "Influencer",
        "Animated"
      ],
      "description": "Who appears on camera \u2014 decides who needs to be booked"
    },
    "production_tier": {
      "type": "string",
      "enum": [
        "Phone shot raw",
        "Phone shot edited",
        "Creator studio quality",
        "Motion design",
        "Studio lit",
        "Commercial production",
        "AI generated"
      ],
      "description": "Production tier \u2014 decides the budget"
    },
    "order": {
      "type": "number"
    },
    "direction": {
      "type": "string",
      "description": "Creative direction for this block of content"
    },
    "quantity": {
      "type": "number"
    },
    "plan_status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ],
      "default": "draft",
      "description": "Mirror of the parent Plan status so draft children are hidden from clients via RLS. Kept in sync whenever the parent Plan status changes."
    }
  },
  "required": [
    "client_slug",
    "angle_id",
    "content_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.client_slug": "{{user.data.client_slug}}"
            },
            {
              "data.plan_status": "published"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}