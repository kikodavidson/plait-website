{
  "name": "Block",
  "type": "object",
  "properties": {
    "client_slug": {
      "type": "string",
      "description": "The slug of the Client this block belongs to"
    },
    "angle_id": {
      "type": "string",
      "description": "ID of the parent Angle"
    },
    "content_type": {
      "type": "string",
      "enum": [
        "HQ photo",
        "graphic carousel",
        "UGC",
        "HQ video edit",
        "static graphic",
        "motion graphic"
      ]
    },
    "order": {
      "type": "number"
    },
    "direction": {
      "type": "string",
      "description": "Creative direction for this block of content"
    },
    "quantity": {
      "type": "number"
    },
    "plan_status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ],
      "default": "draft",
      "description": "Mirror of the parent Plan status so draft children are hidden from clients via RLS. Kept in sync whenever the parent Plan status changes."
    }
  },
  "required": [
    "client_slug",
    "angle_id",
    "content_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.client_slug": "{{user.data.client_slug}}"
            },
            {
              "data.plan_status": "published"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}