{
  "name": "SalesFunnelQuestion",
  "type": "object",
  "properties": {
    "question": {
      "type": "string",
      "description": "The open question"
    },
    "owner": {
      "type": "string",
      "enum": [
        "Luke",
        "Max",
        "Both"
      ],
      "enumColors": [
        "blue",
        "purple",
        "gray"
      ],
      "default": "Both",
      "description": "Who the question is assigned to"
    },
    "answered": {
      "type": "boolean",
      "default": false,
      "description": "Whether the question has been answered"
    },
    "author": {
      "type": "string",
      "description": "Display name of the partner who added it"
    },
    "workspace": {
      "type": "string",
      "default": "partnership",
      "description": "Workspace scope marker used by RLS"
    }
  },
  "required": [
    "question"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.workspace": "{{user.data.client_slug}}"
        },
        {
          "data.workspace": {
            "$in": "{{user.data.workspaces}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.workspace": "{{user.data.client_slug}}"
        },
        {
          "data.workspace": {
            "$in": "{{user.data.workspaces}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.workspace": "{{user.data.client_slug}}"
        },
        {
          "data.workspace": {
            "$in": "{{user.data.workspaces}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.workspace": "{{user.data.client_slug}}"
        },
        {
          "data.workspace": {
            "$in": "{{user.data.workspaces}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}