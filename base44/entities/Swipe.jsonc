{
  "name": "Swipe",
  "type": "object",
  "properties": {
    "file": {
      "type": "string",
      "description": "URL of the saved ad file"
    },
    "thumbnail": {
      "type": "string",
      "description": "URL of the video thumbnail image"
    },
    "file_name": {
      "type": "string",
      "description": "Original uploaded file name, used for duplicate detection"
    },
    "file_size": {
      "type": "number",
      "description": "Original uploaded file size in bytes, used for duplicate detection"
    },
    "source_brand": {
      "type": "string",
      "description": "Brand the ad belongs to"
    },
    "source_url": {
      "type": "string",
      "description": "Original URL where the ad was found"
    },
    "platform": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Meta",
          "TikTok",
          "YouTube",
          "LinkedIn",
          "Pinterest",
          "Snapchat",
          "X",
          "Other"
        ]
      },
      "description": "Essential. Where the creative ran (multi-select)"
    },
    "creative_format": {
      "type": "string",
      "enum": [
        "Raw UGC",
        "Polished UGC",
        "Production Video",
        "Static",
        "Carousel",
        "Motion / Animated",
        "Screen Recording",
        "Mixed Media"
      ],
      "description": "Essential. What type of asset this is"
    },
    "concept": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Talking Head",
          "Voiceover + B-Roll",
          "Testimonial",
          "Creator Review",
          "Founder Story",
          "Founder Explainer",
          "Product Demo",
          "App / Software Demo",
          "Unboxing",
          "Tutorial / How-To",
          "Street Interview",
          "Podcast Clip",
          "Day in the Life",
          "Before & After",
          "Comparison",
          "Reaction",
          "Meme / Trend",
          "Product Showcase",
          "Brand Film",
          "Text-Led Video",
          "Other"
        ]
      },
      "description": "Essential. What is actually happening in the ad (multi-select; first value is the primary concept)"
    },
    "hook": {
      "type": "string",
      "enum": [
        "Problem Callout",
        "Bold Claim",
        "Question",
        "Audience Callout",
        "Stat / Number",
        "Warning",
        "Curiosity",
        "Before & After",
        "Social Proof",
        "POV",
        "Pattern Interrupt",
        "List",
        "Confession",
        "Authority",
        "Trend / Cultural Hook",
        "Competitor Callout",
        "Price / Offer",
        "Visual Hook",
        "No Clear Hook"
      ],
      "description": "Essential. How the creative earns attention at the beginning"
    },
    "angle_type": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Pain Point",
          "Benefit / Outcome",
          "Social Proof",
          "Offer / Discount",
          "Objection Handling",
          "Education",
          "Differentiation",
          "Authority",
          "Urgency / Scarcity",
          "Cost of Inaction",
          "Ease / Convenience",
          "Speed",
          "Identity / Belonging",
          "Aspiration",
          "Risk Reversal",
          "Curiosity",
          "Humor",
          "Community"
        ]
      },
      "description": "Essential. Message Angle \u2014 the core reason the ad gives the viewer to care or act (multi-select; first value is the primary angle)"
    },
    "structure": {
      "type": "string",
      "enum": [
        "Problem \u2192 Solution",
        "Problem \u2192 Agitate \u2192 Solution",
        "Claim \u2192 Proof",
        "Hook \u2192 Benefits \u2192 CTA",
        "Story \u2192 Lesson \u2192 Offer",
        "Before \u2192 After \u2192 How",
        "Objection \u2192 Reframe",
        "Comparison \u2192 Winner",
        "Demo \u2192 Benefit",
        "Testimonial \u2192 Result",
        "Listicle",
        "FAQ / Q&A",
        "Story Arc",
        "Reveal",
        "Other"
      ],
      "description": "Additional. How the ad's argument or story progresses"
    },
    "business_type": {
      "type": "string",
      "enum": [
        "Ecommerce",
        "SaaS / App",
        "B2B",
        "Local Service",
        "Marketplace",
        "Info / Education",
        "Media / Content",
        "Other"
      ],
      "description": "Additional. Business type of the advertiser (separate from industry)"
    },
    "talent": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Customer",
          "Creator",
          "Founder",
          "Employee",
          "Actor / Model",
          "Expert",
          "No Talent / Product Only",
          "Animated / AI"
        ]
      },
      "description": "Additional. Who is delivering or appearing in the creative (multi-select)"
    },
    "setting": {
      "type": "string",
      "enum": [
        "Car",
        "Bedroom",
        "Bathroom / Mirror",
        "Kitchen",
        "Living Space",
        "Office / Desk",
        "Studio",
        "Outdoors",
        "Street",
        "Event / Venue",
        "Gym",
        "Retail / Store",
        "Restaurant / Cafe",
        "Screen Only",
        "Mixed",
        "Other"
      ],
      "description": "Additional. Where the creative is visually taking place"
    },
    "edit_style": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Raw / Minimal Edit",
          "Jump Cuts",
          "Captions",
          "Kinetic Captions",
          "B-Roll Heavy",
          "Text Overlay Heavy",
          "Motion Graphics",
          "Split Screen",
          "Green Screen",
          "Fast Cut / Retention Edit",
          "Cinematic Edit",
          "Montage"
        ]
      },
      "description": "Additional. How the creative is edited (multi-select)"
    },
    "energy": {
      "type": "string",
      "enum": [
        "Calm",
        "Conversational",
        "Energetic",
        "High Energy"
      ],
      "description": "Additional. The overall delivery pace / feeling"
    },
    "why_it_works": {
      "type": "string",
      "description": "Internal analysis of why the ad works"
    },
    "date_saved": {
      "type": "string",
      "format": "date"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "format": {
      "type": "string",
      "description": "Legacy \u2014 superseded by creative_format + concept"
    },
    "shot_type": {
      "type": "string",
      "description": "Legacy \u2014 superseded by concept"
    },
    "production_level": {
      "type": "string",
      "description": "Legacy \u2014 superseded by creative_format"
    },
    "hook_type": {
      "type": "string",
      "description": "Legacy \u2014 superseded by hook"
    },
    "vertical": {
      "type": "string",
      "description": "Legacy \u2014 superseded by business_type"
    }
  },
  "required": [
    "file"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}