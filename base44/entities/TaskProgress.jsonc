{
  "name": "TaskProgress",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "ID of the parent Project"
    },
    "task_id": {
      "type": "string",
      "description": "Task id from the master task list constant"
    },
    "completed": {
      "type": "boolean",
      "default": false
    },
    "completed_at": {
      "type": "string",
      "format": "date",
      "description": "Date the task was completed"
    },
    "note": {
      "type": "string",
      "description": "Per-task note"
    }
  },
  "required": [
    "project_id",
    "task_id"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}