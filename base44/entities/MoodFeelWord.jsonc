{
  "name": "MoodFeelWord",
  "type": "object",
  "properties": {
    "word": {
      "type": "string",
      "description": "The feel word, e.g. Warm, Editorial, Sharp"
    },
    "added_by": {
      "type": "string",
      "enum": [
        "Luke",
        "Max"
      ],
      "description": "Which partner added the word"
    },
    "order": {
      "type": "number",
      "description": "Sort order of the chip"
    },
    "workspace": {
      "type": "string",
      "default": "partnership",
      "description": "Workspace scope marker used by RLS"
    }
  },
  "required": [
    "word",
    "added_by"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.workspace": "{{user.data.client_slug}}"
        },
        {
          "data.workspace": {
            "$in": "{{user.data.workspaces}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.workspace": "{{user.data.client_slug}}"
        },
        {
          "data.workspace": {
            "$in": "{{user.data.workspaces}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.workspace": "{{user.data.client_slug}}"
        },
        {
          "data.workspace": {
            "$in": "{{user.data.workspaces}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.workspace": "{{user.data.client_slug}}"
        },
        {
          "data.workspace": {
            "$in": "{{user.data.workspaces}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}