{
  "name": "PartnershipIdea",
  "type": "object",
  "properties": {
    "tab_id": {
      "type": "string",
      "description": "ID of the parent PartnershipTab (kept for cascade deletes)"
    },
    "section_id": {
      "type": "string",
      "description": "ID of the parent PartnershipSection the idea belongs to"
    },
    "text": {
      "type": "string",
      "description": "The idea"
    },
    "author": {
      "type": "string",
      "description": "Display name of the partner who added it"
    },
    "vote_luke": {
      "type": "string",
      "enum": [
        "love",
        "maybe",
        "no"
      ],
      "description": "Luke's vote on the idea"
    },
    "vote_max": {
      "type": "string",
      "enum": [
        "love",
        "maybe",
        "no"
      ],
      "description": "Max's vote on the idea"
    },
    "workspace": {
      "type": "string",
      "default": "partnership",
      "description": "Workspace scope marker used by RLS"
    }
  },
  "required": [
    "tab_id",
    "section_id",
    "text"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.workspace": "{{user.data.client_slug}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.workspace": "{{user.data.client_slug}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.workspace": "{{user.data.client_slug}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.workspace": "{{user.data.client_slug}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}