{
  "name": "MoodItem",
  "type": "object",
  "properties": {
    "level": {
      "type": "string",
      "enum": [
        "mood",
        "identity",
        "brands",
        "tech"
      ],
      "description": "Board level: Mood, Identity, Brands We Admire, or Tech"
    },
    "sub_section": {
      "type": "string",
      "description": "Sub section within the level, e.g. Imagery, Fonts, Brands We Love"
    },
    "image_url": {
      "type": "string",
      "description": "Public URL of the reference image (uploaded or pasted)"
    },
    "source_link": {
      "type": "string",
      "description": "Optional source link for the reference"
    },
    "note": {
      "type": "string",
      "description": "Why I like it - short required explanation"
    },
    "added_by": {
      "type": "string",
      "enum": [
        "Luke",
        "Max"
      ],
      "description": "Which partner added the reference"
    },
    "vote_luke": {
      "type": "string",
      "enum": [
        "love",
        "cut"
      ],
      "description": "Luke's vote: love or cut (unset = no vote yet)"
    },
    "vote_max": {
      "type": "string",
      "enum": [
        "love",
        "cut"
      ],
      "description": "Max's vote: love or cut (unset = no vote yet)"
    },
    "workspace": {
      "type": "string",
      "default": "partnership",
      "description": "Workspace scope marker used by RLS"
    }
  },
  "required": [
    "level",
    "sub_section",
    "image_url",
    "note",
    "added_by"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.workspace": "{{user.data.client_slug}}"
        },
        {
          "data.workspace": {
            "$in": "{{user.data.workspaces}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.workspace": "{{user.data.client_slug}}"
        },
        {
          "data.workspace": {
            "$in": "{{user.data.workspaces}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.workspace": "{{user.data.client_slug}}"
        },
        {
          "data.workspace": {
            "$in": "{{user.data.workspaces}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.workspace": "{{user.data.client_slug}}"
        },
        {
          "data.workspace": {
            "$in": "{{user.data.workspaces}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}