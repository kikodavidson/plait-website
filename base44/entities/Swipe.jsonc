{
  "name": "Swipe",
  "type": "object",
  "properties": {
    "file": {
      "type": "string",
      "description": "URL of the saved ad video file"
    },
    "thumbnail": {
      "type": "string",
      "description": "URL of the video thumbnail image"
    },
    "source_brand": {
      "type": "string",
      "description": "Brand the ad belongs to"
    },
    "source_url": {
      "type": "string",
      "description": "Original URL where the ad was found"
    },
    "platform": {
      "type": "string",
      "enum": [
        "Meta",
        "TikTok",
        "YouTube",
        "LinkedIn",
        "organic",
        "other"
      ]
    },
    "format": {
      "type": "string",
      "enum": [
        "UGC",
        "talking head",
        "testimonial",
        "product demo",
        "founder",
        "listicle",
        "POV",
        "static",
        "carousel",
        "motion graphic"
      ]
    },
    "hook_type": {
      "type": "string",
      "enum": [
        "question",
        "bold claim",
        "problem",
        "stat",
        "pattern interrupt",
        "before and after",
        "story"
      ]
    },
    "vertical": {
      "type": "string",
      "enum": [
        "ecom",
        "app",
        "B2B",
        "local service",
        "other"
      ]
    },
    "angle_type": {
      "type": "string",
      "enum": [
        "value",
        "social proof",
        "objection handling",
        "offer",
        "education"
      ]
    },
    "why_it_works": {
      "type": "string",
      "description": "Internal analysis of why the ad works"
    },
    "date_saved": {
      "type": "string",
      "format": "date"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "file"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}