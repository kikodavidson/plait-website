{
  "name": "PartnershipNote",
  "type": "object",
  "properties": {
    "section_id": {
      "type": "string",
      "description": "ID of the parent PartnershipSection"
    },
    "tab_id": {
      "type": "string",
      "description": "ID of the parent PartnershipTab (kept for cascade deletes)"
    },
    "body": {
      "type": "string",
      "description": "Discussion log entry text"
    },
    "author": {
      "type": "string",
      "description": "Display name of the partner who wrote the entry"
    },
    "workspace": {
      "type": "string",
      "default": "partnership",
      "description": "Workspace scope marker used by RLS"
    }
  },
  "required": [
    "section_id",
    "tab_id",
    "body"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.workspace": "{{user.data.client_slug}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.workspace": "{{user.data.client_slug}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.workspace": "{{user.data.client_slug}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.workspace": "{{user.data.client_slug}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}