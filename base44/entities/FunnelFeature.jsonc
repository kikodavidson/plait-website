{
  "name": "FunnelFeature",
  "type": "object",
  "properties": {
    "service": {
      "type": "string",
      "description": "Service group this row belongs to, e.g. Strategy, Paid ads"
    },
    "what_we_do": {
      "type": "string",
      "description": "The feature we deliver"
    },
    "what_they_get": {
      "type": "string",
      "description": "The value it does for the business"
    },
    "why_they_care": {
      "type": "string",
      "description": "The benefit, how the owner's life changes"
    },
    "core_benefit": {
      "type": "string",
      "description": "Which of the five core benefits this row sells on"
    },
    "order": {
      "type": "number",
      "description": "Sort order in the table"
    },
    "workspace": {
      "type": "string",
      "default": "partnership",
      "description": "Workspace scope marker used by RLS"
    }
  },
  "required": [
    "what_we_do"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.workspace": "{{user.data.client_slug}}"
        },
        {
          "data.workspace": {
            "$in": "{{user.data.workspaces}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.workspace": "{{user.data.client_slug}}"
        },
        {
          "data.workspace": {
            "$in": "{{user.data.workspaces}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.workspace": "{{user.data.client_slug}}"
        },
        {
          "data.workspace": {
            "$in": "{{user.data.workspaces}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.workspace": "{{user.data.client_slug}}"
        },
        {
          "data.workspace": {
            "$in": "{{user.data.workspaces}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}