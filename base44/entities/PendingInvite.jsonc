{
  "name": "PendingInvite",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Email the invite was sent to (lowercased on write)"
    },
    "client_slug": {
      "type": "string",
      "description": "Client slug to assign to the user on first login"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "client"
      ],
      "default": "client"
    }
  },
  "required": [
    "email",
    "client_slug"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}